# ============================================================
# Pr III Table Extraction Pipeline — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# REQUIRED: Your Google Gemini API key
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OPTIONAL: Gemini model to use (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-3-flash-preview

# OPTIONAL: Image DPI for PDF conversion (default: 300)
# Higher values = better OCR quality but larger images & more tokens
# PDF_DPI=300
